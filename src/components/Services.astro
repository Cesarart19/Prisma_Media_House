---
// Services section with four main service cards
const services = [
  {
    title: "Producción de Contenido para Empresas",
    description: "Videos corporativos, institucionales, promocionales, testimoniales, entrevistas y contenido para redes sociales. Eleva la imagen de tu marca con contenido profesional.",
    icon: "video",
    features: ["Videos corporativos", "Contenido para redes", "Entrevistas", "Cobertura de eventos"]
  },
  {
    title: "Planes Mensuales de Contenido",
    description: "Servicio recurrente que incluye grabación, edición y distribución de contenido mensual. Mantén tu audiencia conectada con contenido constante y profesional.",
    icon: "calendar",
    features: ["Contenido mensual", "Grabación + edición", "Distribución", "Estrategia de contenido"]
  },
  {
    title: "Cursos y Entrevistas",
    description: "Producción profesional de cursos online, entrevistas empresariales y podcasts con video. Transforma tu conocimiento en contenido de valor.",
    icon: "education",
    features: ["Cursos online", "Entrevistas", "Podcasts", "Webinars"]
  },
  {
    title: "Alquiler de Equipos",
    description: "Cámaras profesionales, iluminación, audio y equipos de grabación. Incluye la opción de operador para garantizar los mejores resultados.",
    icon: "equipment",
    features: ["Cámaras 4K", "Iluminación", "Audio profesional", "Con operador"]
  }
];
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Nuestros Servicios</span>
      <h2 class="section-title">Soluciones audiovisuales para cada necesidad</h2>
      <p class="section-subtitle">
        Ofrecemos una gama completa de servicios de producción audiovisual 
        diseñados para empresas, marcas y creadores de contenido.
      </p>
    </div>
    
    <div class="services-grid">
      {services.map((service, index) => (
        <div class="service-card reveal" style={`animation-delay: ${index * 0.1}s`}>
          <div class="service-icon">
            {service.icon === 'video' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            )}
            {service.icon === 'calendar' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            )}
            {service.icon === 'education' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            )}
            {service.icon === 'equipment' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
                <circle cx="12" cy="13" r="3"></circle>
              </svg>
            )}
          </div>
          
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
          
          <ul class="service-features">
            {service.features.map(feature => (
              <li class="feature-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
          
          <a href="https://wa.me/57XXXXXXXXXX?text=Hola,%20me%20interesa%20el%20servicio%20de%20{encodeURIComponent(service.title)}" 
             class="service-link" 
             target="_blank" 
             rel="noopener noreferrer">
            Consultar precio
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-bg-secondary);
  }
  
  [data-theme="dark"] .services {
    background-color: var(--color-bg-secondary-dark);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .section-badge {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: rgba(27, 42, 74, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: var(--spacing-md);
  }
  
  [data-theme="dark"] .section-badge {
    background-color: rgba(192, 192, 192, 0.1);
    color: var(--color-secondary);
  }
  
  .section-title {
    margin-bottom: var(--spacing-md);
  }
  
  .section-subtitle {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }
  
  .service-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    transition: all var(--transition-fast);
    display: flex;
    flex-direction: column;
  }
  
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }
  
  [data-theme="dark"] .service-card:hover {
    border-color: var(--color-secondary);
  }
  
  .service-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border-radius: var(--radius-md);
    color: white;
    margin-bottom: var(--spacing-lg);
  }
  
  .service-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }
  
  .service-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
    flex-grow: 1;
  }
  
  .service-features {
    list-style: none;
    margin-bottom: var(--spacing-lg);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xs);
  }
  
  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  
  .feature-item svg {
    color: var(--color-whatsapp);
    flex-shrink: 0;
  }
  
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-primary);
    font-weight: 500;
    transition: all var(--transition-fast);
  }
  
  [data-theme="dark"] .service-link {
    color: var(--color-secondary);
  }
  
  .service-link:hover {
    color: var(--color-accent);
    gap: var(--spacing-sm);
  }
  
  /* Responsive */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    
    .service-features {
      grid-template-columns: 1fr;
    }
  }
</style>
