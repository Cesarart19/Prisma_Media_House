---
// Footer component with social links and contact
const socialLinks = [
  { name: "Instagram", url: "#", icon: "instagram", color: "#E4405F" },
  { name: "Facebook", url: "#", icon: "facebook", color: "#1877F2" },
  { name: "TikTok", url: "#", icon: "tiktok", color: "#000000" },
  { name: "YouTube", url: "#", icon: "youtube", color: "#FF0000" }
];

const footerLinks = [
  { name: "Servicios", url: "#servicios" },
  { name: "Portafolio", url: "#portafolio" },
  { name: "Proceso", url: "#proceso" },
  { name: "Nosotros", url: "#nosotros" }
];
---

<footer class="footer">
  <div class="container">
    <!-- CTA Section -->
    <div class="footer-cta">
      <div class="cta-content">
        <h2 class="cta-title">¿Listo para crear contenido?</h2>
        <p class="cta-description">
          Cuéntanos tu idea y hagamos que tu marca destaque con contenido audiovisual profesional.
        </p>
        <a href="https://wa.me/584149656283?text=Hola,%20me%20interesa%20un%20servicio%20de%20producción%20audiovisual" 
           class="btn btn-cta" 
           target="_blank" 
           rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Cotiza tu proyecto
        </a>
      </div>
      <div class="cta-decoration">
        <div class="cta-circle"></div>
        <div class="cta-circle cta-circle-2"></div>
      </div>
    </div>
    
    <!-- Footer Content -->
    <div class="footer-content">
      <!-- Logo & Description -->
      <div class="footer-brand">
        <a href="#inicio" class="footer-logo">
          <span class="logo-text">PRISMA</span>
          <span class="logo-subtitle">MEDIA HOUSE</span>
        </a>
        <p class="footer-description">
          Productora audiovisual profesional. Producción de videos corporativos, 
          contenido para redes sociales, cursos, entrevistas y más.
        </p>
        <div class="social-links">
          {socialLinks.map(link => (
            <a href={link.url} class="social-link" style={`--social-color: ${link.color}`} target="_blank" rel="noopener noreferrer" aria-label={link.name}>
              {link.icon === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              )}
              {link.icon === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              )}
              {link.icon === 'tiktok' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              )}
              {link.icon === 'youtube' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
      
      <!-- Navigation -->
      <div class="footer-nav">
        <h4 class="footer-nav-title">Navegación</h4>
        <ul class="footer-nav-list">
          {footerLinks.map(link => (
            <li>
              <a href={link.url} class="footer-nav-link">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Contact -->
      <div class="footer-contact">
        <h4 class="footer-nav-title">Contacto</h4>
        <ul class="footer-contact-list">
          <li>
            <a href="https://wa.me/584149656283" class="footer-contact-link" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              WhatsApp
            </a>
          </li>
          <li>
            <a href="mailto:contacto@prismamediahouse.com" class="footer-contact-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Email
            </a>
          </li>
          <li>
            <span class="footer-contact-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Bogotá, Colombia
            </span>
          </li>
        </ul>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Prisma Media House. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: white;
    padding-top: var(--spacing-3xl);
    position: relative;
    overflow: hidden;
  }
  
  [data-theme="dark"] .footer {
    background-color: var(--color-bg-dark);
    border-top: 1px solid var(--color-border-dark);
  }
  
  /* CTA Section */
  .footer-cta {
    text-align: center;
    padding: var(--spacing-3xl);
    background: linear-gradient(135deg, rgba(184, 115, 51, 0.2), rgba(27, 42, 74, 0.3));
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-3xl);
    position: relative;
    overflow: hidden;
  }
  
  .cta-content {
    position: relative;
    z-index: 2;
  }
  
  .cta-decoration {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }
  
  .cta-circle {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(184, 115, 51, 0.1);
    top: -100px;
    right: -100px;
  }
  
  .cta-circle-2 {
    width: 200px;
    height: 200px;
    background: rgba(255, 255, 255, 0.05);
    top: auto;
    right: auto;
    bottom: -50px;
    left: -50px;
  }
  
  .cta-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: var(--spacing-md);
    color: white;
  }
  
  .cta-description {
    color: rgba(255, 255, 255, 0.85);
    max-width: 500px;
    margin: 0 auto var(--spacing-xl);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 2.5rem;
    background-color: var(--color-whatsapp);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
  }
  
  .btn-cta:hover {
    background-color: var(--color-whatsapp-hover);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.5);
  }
  
  /* Footer Content */
  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-3xl);
    padding-bottom: var(--spacing-2xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .footer-brand {
    max-width: 350px;
  }
  
  .footer-logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    margin-bottom: var(--spacing-md);
    transition: transform 0.3s ease;
  }
  
  .footer-logo:hover {
    transform: scale(1.02);
  }
  
  .footer-logo .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    letter-spacing: 0.1em;
  }
  
  .footer-logo .logo-subtitle {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.2em;
  }
  
  .footer-description {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--spacing-lg);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  
  .social-links {
    display: flex;
    gap: var(--spacing-sm);
  }
  
  .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    color: white;
    transition: all 0.3s ease;
  }
  
  .social-link:hover {
    background-color: var(--social-color);
    transform: translateY(-4px) scale(1.1);
  }
  
  /* Navigation */
  .footer-nav-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    color: white;
    position: relative;
    padding-bottom: var(--spacing-sm);
  }
  
  .footer-nav-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-accent);
  }
  
  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-nav-list li {
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-nav-link {
    color: rgba(255, 255, 255, 0.7);
    transition: all 0.3s ease;
    font-size: 0.9375rem;
    display: inline-block;
  }
  
  .footer-nav-link:hover {
    color: white;
    transform: translateX(4px);
  }
  
  /* Contact */
  .footer-contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-contact-list li {
    margin-bottom: var(--spacing-sm);
  }
  
  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
    transition: all 0.3s ease;
  }
  
  .footer-contact-link:hover {
    color: white;
    transform: translateX(4px);
  }
  
  /* Copyright */
  .footer-bottom {
    padding: var(--spacing-lg) 0;
    text-align: center;
  }
  
  .copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
    margin: 0;
  }
  
  /* Responsive */
  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }
    
    .footer-brand {
      grid-column: span 2;
    }
  }
  
  @media (max-width: 768px) {
    .footer-cta {
      padding: var(--spacing-xl);
    }
    
    .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
    .footer-brand {
      grid-column: span 1;
    }
    
    .social-links {
      justify-content: center;
    }
    
    .footer-nav-title::after {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
